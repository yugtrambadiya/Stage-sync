{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": ["**/*.(t|j)s"],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@smart-anchor/database$": "<rootDir>/../../packages/database/src/index.ts",
    "^@smart-anchor/shared$": "<rootDir>/../../packages/shared/src/index.ts"
  }
}
