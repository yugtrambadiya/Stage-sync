{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@smart-anchor/database": ["../../packages/database/src"],
      "@smart-anchor/shared": ["../../packages/shared/src"]
    },
    "incremental": true,
    "strict": true,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*"]
}