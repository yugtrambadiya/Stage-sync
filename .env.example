# Database
DATABASE_URL="postgresql://smart_anchor:smart_anchor@localhost:5432/smart_anchor?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# AI
GEMINI_API_KEY=""

# Auth
AUTH_SECRET="replace-with-a-long-random-secret"

# API / Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# Timezone for schedule validation (default: Asia/Kolkata)
EVENT_TIMEZONE="Asia/Kolkata"

# Seed data date override (YYYY-MM-DD, defaults to today)
SEED_EVENT_DATE=""

# Demo reset guard: set to "true" to allow POST /api/reset in NODE_ENV=production
# IMPORTANT: Never set in production without explicit intent (demo deployments only)
ALLOW_DEMO_RESET="false"

# Google OAuth (optional — for "Sign in with Google")
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000 as an authorized JavaScript origin
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
